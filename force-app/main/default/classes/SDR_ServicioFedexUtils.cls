    /**
     * @description Metodo generico para llamar servicios
     * @return HttpResponse
     */
    private static HttpResponse sendApi( string sUrl, string sMethod, map<string,string> mapHeaderParams, string jsonStr) {
        
        Http http = new Http();
        HttpRequest request = new HttpRequest();
        
        request = new HttpRequest();
        request.setEndpoint(sUrl);
        request.setMethod(sMethod);
        request.setTimeout(120000);
        
        //carga cabecera de llamada
        if (mapHeaderParams != null) {
            if(mapHeaderParams.size() > 0 ) {
                for( string sParam : mapHeaderParams.keySet() ) {
                    string hdrKey = sParam;
                    string hdrValue = mapHeaderParams.get(sParam);                    
                    request.setHeader( hdrKey , hdrValue);
                }
            }
        }
        if (jsonStr != null && jsonStr != '') {
            request.setBody( jsonStr );
        }
        HttpResponse response = new HttpResponse();
        try {
            response = http.send(request);               
        } catch ( CalloutException e) {
            system.debug('SDR_ServicioFedexUtils::sendApi:EXCEP > ' + e);
            System.debug('response->'+response);
        }
        return response;   
    }

