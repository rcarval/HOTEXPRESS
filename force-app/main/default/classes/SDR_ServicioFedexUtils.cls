    //respuesta de token 
    public class RespToken
    {
        public String accessToken;
        public Integer expiresIn;
        public String tokenType;
        public String scope;
        
        public RespToken parse(String json) {
            json = json.replaceAll('access_token','accessToken');
            json = json.replaceAll('expires_in','expiresIn');
            json = json.replaceAll('token_type','tokenType');
            return (RespToken) System.JSON.deserialize(json, RespToken.class);
        }
    }
    
