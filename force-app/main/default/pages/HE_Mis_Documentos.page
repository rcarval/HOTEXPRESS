            }
            function inicio() {
                console.log('inicio');
                $("#loading").show();
                window.location.replace("{!$Page.HE_Inicio}?idc={!idc}&&idp={!idp}");   
            }
            function clear(){
                $('#fecha_inicio').val('');
                $('#fecha_fin').val('');
                $('#guia').val('');                
                
                var now = new Date();
                var day = ("0" + now.getDate()).slice(-2);
                var month = ("0" + (now.getMonth() + 1)).slice(-2);    
                var lastmonth = ("0" + (now.getMonth() - 2)).slice(-2);    
                var today = now.getFullYear()+"-"+(month)+"-"+(day) ;
                var yesterday = now.getFullYear()+"-"+(lastmonth)+"-"+(day) ;
                
                const formattedToday = now.toISOString().slice(0, 10); // Convert to "YYYY-MM-DD" format
                const resultDate = subtractMonthsFromDate(formattedToday, 3);
                console.log("Menos 3 meses al origen:", resultDate);
                
                $('#fecha_inicio').val(resultDate);                         
                $("#fecha_fin").val(today);  
                $("#consultar").click();                
            }
            
            function subtractMonthsFromDate(dateStr, months) {
                const date = new Date(dateStr);
                date.setMonth(date.getMonth() - months);
                
                // If the original day of the month is greater than the new month's last day,
                // set the day to the last day of the new month
                const originalDay = new Date(dateStr).getDate();
                const newMonthLastDay = new Date(date.getFullYear(), date.getMonth() + 1, 0).getDate();
                date.setDate(Math.min(originalDay, newMonthLastDay));
                
                // Format the result as "YYYY-MM-DD"
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                
                return `${year}-${month}-${day}`;
            }
            </script>
