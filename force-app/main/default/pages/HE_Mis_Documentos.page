            <script>
            $j = jQuery.noConflict();
            $j(document).ready(function($) {
                $("#divtablaGuias").hide();
                $("#divtablaRetiro").hide();
                $("#divtablaPickup").hide();
                
                /*   $("#ver_guia").on('click',function(dato){
                   console.log(dato);  
                    var r= $("#ver_guia").val();
                     console.log(r);
                     window.open("/portal/apex/HE_guia_hot?id="+r,"ventana1","width=1000,height=500,scrollbars=NO") 
                     });
                
                */               
                
                $("#contenido").on('change',function(){
                    var cont = $("#contenido").val();
                    console.log(cont );
                    if(cont=="Guias"){
                        
                        var now = new Date();
                        var day = ("0" + now.getDate()).slice(-2);
                        var month = ("0" + (now.getMonth() + 1)).slice(-2);    
                        var lastmonth = ("0" + (now.getMonth() - 2)).slice(-2);    
                        var today = now.getFullYear()+"-"+(month)+"-"+(day) ;
                        var yesterday = now.getFullYear()+"-"+(lastmonth)+"-"+(day) ;
                           
                        const formattedToday = now.toISOString().slice(0, 10); // Convert to "YYYY-MM-DD" format
                        const resultDate = subtractMonthsFromDate(formattedToday, 3);
                        console.log("Menos 3 meses al origen:", resultDate);
                        
                        $('#fecha_inicio').val(resultDate);                         
                		$("#fecha_fin").val(today);     

                        $("#divtablaGuias").show();
                        $("#divtablaRetiro").hide();
                        $("#divtablaPickup").hide();
                        $("#consultar").click();
                    }
                    if(cont=="Retiro"){
                        $("#divtablaRetiro").show();
                        $("#divtablaGuias").hide();
                        $("#divtablaPickup").hide();
                    }
                    if(cont=="Pickup"){
                        $("#divtablaPickup").show();
                        $("#divtablaGuias").hide();
                        $("#divtablaRetiro").hide();
                    }
                    if(cont==" "){
                        $("#divtablaPickup").hide();
                        $("#divtablaGuias").hide();
                        $("#divtablaRetiro").hide();
                    }
                    
                    
                });      
                $("#clear").on('click',function(){
                    clear();                   
                });
                $("#consultar").on('click',function(){
                    
                    var date1 = new Date($('#fecha_inicio').val());
        			var date2 = new Date($('#fecha_fin').val());
                    
                    var diffInMilliseconds = date2 - date1;
        			var diffInDays = diffInMilliseconds / (1000 * 60 * 60 * 24);
                    
                    if(diffInDays > 93){
                        alert('máximo 3 meses');
                        return;
                    }
                    
                    BtnLoading("#consultar");
                    var guia =  $("#guia").val();
                    var fecha_inicio =  $("#fecha_inicio").val();
                    var fecha_fin =  $("#fecha_fin").val();
                    var contenido =  $("#contenido").val();
                    var idc =  '{!idc}';
                    var idp =  '{!idp}';
                                        
                    console.log(guia); 
                    console.log(fecha_fin); 
                    console.log(contenido); 
                    console.log(fecha_inicio); 
                    $('#tb').DataTable().destroy();
                    console.log('destruccion tabla'); 
                    $.ajax({
                        dataType: "json",
                        
                        url: "{!$Page.HE_Mis_Documentos_Guias_JSON}?",
                        data: { guia: guia,fi:fecha_inicio,fn:fecha_fin,idc:idc},
                        error: function(jqXHR, textStatus, errorThrown){
                            	console.log('jqXHR:'+ jqXHR); 
                            	console.log('textStatus:'+ textStatus); 
                            	alert('Error al carga la data: ' + textStatus);
                            	BtnReset("#consultar");
                            },
                        success: function(data) {
                            console.log(data);
                            if(data.success){
                                var tabla='';
                                if(data.guias.length>0){
                                    for(var i=0;i<data.guias.length;i++){
                                        tabla+="<tr >";
                                        tabla+="<td style='color:#9aa0ac'  >"+data.guias[i].Estado_Guia__c+"</td>";  
                                        tabla+="<td style='color:#9aa0ac'   >"+data.guias[i].Name+"</td>";  
                                        tabla+="<td style='color:#9aa0ac'   >"+data.guias[i].N_de_Guia__c+"</td>";  
                                        tabla+="<td style='color:#9aa0ac'   >"+data.guias[i].Agente__c+"</td>"; 
                                        tabla+="<td style='color:#9aa0ac'   >"+data.guias[i].CreatedDate+"</td>";  
                                        tabla+="<td style='color:#9aa0ac'   >"+data.guias[i].Direccion_Destinatario__name+"</td>";  
                                        tabla+="<td style='color:#9aa0ac'   >"+data.guias[i].Pais__c+"</td>"; 
                                        tabla+="<td style='color:#9aa0ac'   >"+data.guias[i].Proposito_del_Envio__c+"</td>";
                                         tabla+="<td style='color:#9aa0ac'   >"+data.guias[i].Centro_de_Costo__c+"</td>";
                                        tabla+="<td style='color:#9aa0ac'   ><button id='ver_guia' value="+data.guias[i].id+" class='btn btn-secondary btn-sm' onclick='ver_guia(this);'>descargar</button> </td>";
                                        tabla+="<td style='color:#9aa0ac'   ><button id='ver_Factura' value="+data.guias[i].id+" class='btn btn-secondary btn-sm' onclick='ver_factura(this);'>descargar</button> </td>";
                                        //tabla+= data.guias[i].attachmentId == ''? "<td style='color:#9aa0ac'></td>"  : "<td style='color:#9aa0ac'><button id='ver_customerDocs' value="+data.guias[i].attachmentId+" class='btn btn-secondary btn-sm' onclick='ver_customerDocs(this);'>descargar</button> </td>"? 
                                        
                                        if(data.guias[i].attachmentId != '')
                                        {
                                            tabla+="<td style='color:#9aa0ac'><button id='ver_customerDocs' value=" + data.guias[i].attachmentUrl + " class='btn btn-secondary btn-sm' onclick='ver_customerDocs(this);'>descargar</button> </td>";
                                        }
                                        else{
                                            tabla+="<td style='color:#9aa0ac'></td>";
                                        }
                                        
                                        tabla+="</tr>";          
                                    } 
                                }
                                $("#tabladatosguias").html(tabla);
                                //$('#tb').DataTable();
                                 new DataTable('#tb', {
                                    order: [[4, 'desc']]
                                });
                                $("#tb").css("width", "100%");
                                BtnReset("#consultar");
                            }else{
                               	BtnReset("#consultar");
                            }
                        }
                    });   
                });
            });
            
            function BtnLoading(elem) {
                $(elem).attr("data-original-text", $(elem).html());
                $(elem).prop("disabled", true);
                $(elem).html('<i class="spinner-border spinner-border-sm"></i> Loading...');
            }
            
            function BtnReset(elem) {
                $(elem).prop("disabled", false);
                $(elem).html($(elem).attr("data-original-text"));
            }
            
            function ver_guia(dato){
                
                //   console.log(dato);
                window.open("/apex/HE_guia_hot?id="+dato.value,"ventana1","width=1000,height=500,scrollbars=NO"); 
                
            }
            function ver_factura(dato){
                
                //console.log(dato);
                
                window.open("/apex/HE_factura_expo?id="+dato.value,"ventana1","width=1000,height=500,scrollbars=NO"); 
                
            }
            
            function ver_customerDocs(attachmentUrl){               
                window.open(attachmentUrl.value, "_blank");                    
            }
            
            function nuevo_envio() {
                console.log('nuevo_envio');
                $("#loading").show();
                window.location.replace("{!$Page.HE_Nuevo_Envio}?idc={!idc}&&idp={!idp}");   
            }
            function nueva_solicitud() {
                console.log('nueva_solicitud');
                $("#loading").show();
                window.location.replace("{!$Page.HE_solicitud_de_Retiro}?idc={!idc}&&idp={!idp}");   
