            <script>
            
            
            var maxStringSize = 6000000;    //Maximum String size is 6,000,000 characters
            var maxFileSize = 4350000;      //After Base64 Encoding, this is the max file size
            var chunkSize = 950000;         //Maximum Javascript Remoting message size is 1,000,000 characters
            var attachment;
            var attachmentName;
            var fileSize;
            var positionIndex;
            var doneUploading;
            var xmls;
            $j = jQuery.noConflict();
            $j(document).ready(function($) {				                                                             
                
                $("#NuevoContacto").hide();
                $("#NuevoDestinatario").modal('hide');
                $("#Nuevadireccion").hide();
                $("#otra_direcion").hide();
                $("#agregardireccion").hide();
                
                $("#otro_contacto").hide();
                $("#Agregar_Contacto").hide();
                $("#Cancelar_Contacto").hide();
                $("#loading").hide();
                $("#Contacto").val('{!idp}');
                $("#DDP").val('NO');
                $("#MensajeDDP").hide(); 
                $("#DDP").attr('disabled', false);
                $("#Seguro").val('NO');
                $("#MensajeSeguro").hide();   
                $("#Proposito_del_envio").val('');
                $("#breve_descripcion").val('');
                $("#Embalaje").val('');
                var contador=0;
                
                
                data={!resultJSON};
                dataOrigen={!resultJSONOrigen};
                lstacon={!lcontactosJSON};
                localaddres = {!localAddressesJSON};
                direccion=[];
                direccionOrigen=[];
                contactos=[];
                localAddresses=[];
                
                console.log(data); 
                $.each( data, function( key, c ) {
                    direccion.push({
                        id: c.id,
                        nombre: c.nombre, 
                        Direccion:c.Direccion,  
                        Ciudad :c.Ciudad,
                        Estado_Provincia:c.Estado_Provincia, 
                        codigo_Postal:c.codigo_Postal, 
                        Pais:c.Pais,
                        contacto:c.contacto, 
                        Telefono:c.Telefono, 
                        Email:c.Email,
                        TaxID : c.TaxID
                    });
                    
                    
                });
                $.each( dataOrigen, function( key, c ) {
                    direccionOrigen.push({
                        id: c.id,
                        nombre: c.nombre, 
                        Direccion:c.Direccion,  
                        Ciudad :c.Ciudad,
                        Estado_Provincia:c.Estado_Provincia, 
                        codigo_Postal:c.codigo_Postal, 
                        Pais:c.Pais 
                    });
                });
                
                $.each( lstacon, function( key, c ) {
                    contactos.push({
                        id: c.Id,
                        nombre: c.FirstName, 
                        Apellido: c.LastName,                        
                        Telefono: c.MobilePhone,
                        Direccion: c.MailingStreet
                        
                    });                 
                });
                
                $.each({!localAddressesJSON}, function( key, c ) {
                    localAddresses.push({
                        id: c.id,
                        nombre: c.nombre, 
                        Direccion: c.Direccion
                        
                     });    
                    console.log('xx: ' + c.id);  
                });
                
                console.log(localAddresses);         
                
                for(i=0;i<direccion.length;i++) { 
                    //document.getElementById("direcciones").options[document.getElementById("direcciones").options.length]=new Option(direccion[i].nombre , direccion[i].id);
                    $('#direcciones').append(new Option(direccion[i].nombre + ' - ' + direccion[i].Direccion, data[i].id));
                }
                for(i=0;i<direccionOrigen.length;i++) { 
                    document.getElementById("dir_or").options[document.getElementById("dir_or").options.length]=new Option(direccionOrigen[i].nombre , direccionOrigen[i].id);
                }
                
                //Evento cuando cambia seleccion de combo de direcciones
                $("#direcciones").on('change',function(){
                    var dir = $("#direcciones").val();
                    console.log(dir );
                    for(var i=0; i<direccion.length; i++){ 
                        if(direccion[i].id==dir){
                            $("#Nombre").html(direccion[i].nombre);
                            $("#direccion").html(direccion[i].Direccion);    
                            $("#ciudad").html(direccion[i].Ciudad);   
                            $("#Estado_Provincia").html(direccion[i].Estado_Provincia);
                            $("#codigo_Postal").html(direccion[i].codigo_Postal);
                            $("#Pais").html(direccion[i].Pais);                                                                                    
                            $("#contacto").val(direccion[i].contacto);
                            $("#email").val(direccion[i].Email);
                            $("#taxID").val(direccion[i].TaxID);
                            $("#telefono").val(direccion[i].Telefono); 
                            if(direccion[i].contacto != '' && direccion[i].Email != '' && direccion[i].Telefono != ''){
                                $("#contacto").attr("readonly", true);
                                $("#email").attr("readonly", true);
                                $("#telefono").attr("readonly", true);
                            }else{
                                $("#contacto").attr("readonly", false);
                                $("#email").attr("readonly", false);
                                $("#telefono").attr("readonly", false);
                            }
                            
                            
                            if(direccion[i].id=="0"){
                                $("#Nombre").html(""); 
                            }
                        }
                    }                    
                });    
                
                $("#cambiar_contacto").on('click',function(){
                    //$("#NuevoContacto").show();
                    $('#NuevoContacto').modal('show');                    
                });
                $("#cancelar").on('click',function(){
                    $("#NuevoContacto").hide();
                });
                $("#Cambiar").on('click',function(){
                    var conid =$("#Contacto").val();
                    var nom='';
                    var id='';
                    var tel='';
                    var direccionContacto = '';
                    console.log('conid');
                    console.log(conid);
					
                    $("#telefonocontacto").html('');    
					$("#direccionSeleccionada").html('');                    
                    //busca nombre de contacto cambiado al seleccionar 
                    for(i=0;i<contactos.length;i++){                        
                        if(conid==contactos[i].id){
                            console.log(contactos[i]);
                            nom=contactos[i].nombre;
                            id=conid;
                            tel=contactos[i].Telefono;                            
                            direccionContacto = contactos[i].Direccion;
                            apellido = contactos[i].Apellido;
                        }
                    }
                    
                    console.log(tel);
                    $("#nombrecontacto").val(id); 
                    $("#nombrecontacto").html(nom + ' ' + apellido);
                    $("#telefonocontacto").html(tel);    
                    $("#direccionSeleccionada").html(direccionContacto);
                    $("#NuevoContacto").hide();
                    $('#NuevoContacto').modal('hide');
                    
                });
                $("#Agregar_Direcion").on('click',function(){
                    $("#NuevoDestinatario").modal('show');
                    //$("#Pais_nuevo option:contains(Chile)").attr('selected', 'selected');	
                    $('#Pais_nuevo').selectpicker('refresh');
                    $('#Pais_nuevo').selectpicker('render');                    
                    setTimeout($("#nombre_nuevo").focus(), 2);
                });
                $("#cambiar_direcion").on('click',function(){   
                    //$('#dir_or').val('0');
                    //$("#Nuevadireccion").show();                                        
                    $('#Nuevadireccion').modal('show');                                        
                }); 
                $("#cancelardireccion").on('click',function(){
                    $("#agregardireccion").hide();
                    $("#selecionardireccion").show();
                    $("#selecion_direcion").show();
                    $("#otra_direcion").hide();
                    $("#Nuevadireccion").hide();
                    $('#Nuevadireccion').modal('hide');
                });
                $("#nue_dir_or").on('click',function(){
                    $("#agregardireccion").show();
                    $("#selecionardireccion").hide();
                    $("#otra_direcion").show();
                    $("#selecion_direcion").hide();
					$("#PaisNE option:contains(Chile)").attr('selected', 'selected');	
                    $('#PaisNE').selectpicker('refresh');
                    $('#PaisNE').selectpicker('render');  
                    setTimeout($("#nom").focus(), 2);
                });
                $("#Nuevo_Contacto").on('click',function(){
                    $("#contacto_selecionado").hide();
                    $("#Nuevo_Contacto").hide();
                    $("#Cambiar").hide();
                    $("#otro_contacto").show();
                    $("#Agregar_Contacto").show();
                    $("#Cancelar_Contacto").show();
                    $('#contactDropdownList').hide();
                    setTimeout($("#Nombre_contacto").focus(), 2);
                });
                $("#Cancelar_Contacto").on('click',function(){
                    $("#contacto_selecionado").show();
                    $("#Nuevo_Contacto").show();
                    $("#Cambiar").show();
                    $("#otro_contacto").hide();
                    $("#Agregar_Contacto").hide();
                    $("#Cancelar_Contacto").hide();
                    $('#contactDropdownList').show();
                });
                
                function BtnLoading(elem) {
                      $(elem).attr("data-original-text", $(elem).html());
                      $(elem).prop("disabled", true);
                      $(elem).html('<i class="spinner-border spinner-border-sm"></i> Loading...');
                  }
                
                function BtnReset(elem) {
                    $(elem).prop("disabled", false);
                    $(elem).html($(elem).attr("data-original-text"));
                }
                
                $("#Agregar_Contacto").on('click',function(){
                    var nombre = $("#Nombre_contacto").val();
                    var apellidos =  $("#Apellidos_contacto").val();
                    var correo = $("#Correo_Electronico").val();
                    var telefono = $("#Telefono_contacto").val();
                    var direccion = $("#Direccion_contacto").val();
                    var comuna = $("#Comuna_contacto").val();
                    var ciudad = $("#Ciudad_contacto").val();
                    
                    if(nombre == ''){
                        $("#Nombre_contacto").focus();
                        return alert('Ingrese nombre');
                    }
                    if(apellidos == ''){
                        $("#Apellidos_contacto").focus();
                        return alert('Ingrese apellidos');
                    }
                    if(telefono == ''){
                        $("#Telefono_contacto").focus();
                        return alert('Ingrese telefono');
                    }
                    if(direccion == ''){
                        $("#Direccion_contacto").focus();
                        return alert('Ingrese dirección');
                    }
					if(comuna == ''){
                        $("#Comuna_contacto").focus();
                        return alert('Ingrese comuna');
                    }
					if(ciudad == ''){
                        $("#Ciudad_contacto").focus();
                        return alert('Ingrese ciudad');
                    }

                    
                    BtnLoading("#Agregar_Contacto");
                    var datos = {
                        "Idcuenta":"{!idc}",
                        "Nombre": nombre,
                        "Apellidos":apellidos,
                        "Correo":correo,
                        "Telefono": telefono, 
                        "Tipo_Cargo": "Otro",
                        "Direccion": direccion,
                        "Comuna": comuna,
                        "Ciudad": ciudad, 
                        "Pais": $("#Pais_contacto").val()
                    };
                    console.log(datos);
                    $.ajax({
                        dataType: "json",
                        
                        url: "{!$Page.HE_AgregaContacto_JSON}",
                        data: { datos: JSON.stringify(datos) },
                        success: function(data) {
                            console.log(data);
                            BtnReset("#Agregar_Contacto");
                            if(data.success){ 
                                contactos.push({
                                    id: data.idcontacto,
                                    nombre: nombre, 
                                    Telefono:telefono,
									Apellido : apellidos,
                                    Direccion : direccion
                                });
                                
                                $('#Contacto').append(new Option(nombre + ' ' + apellidos + ' - ' + direccion, data.idcontacto));
                                $("#Contacto").val(data.idcontacto); 
                                $("#Nombre_contacto").val('');  
                                $("#Apellidos_contacto").val('');
                                $("#Correo_Electronico").val('');
                                $("#Telefono_contacto").val('');
                                $("#Direccion_contacto").val('');
                                $("#Comuna_contacto").val('');
                                $("#Ciudad_contacto").val('');
                                $("#Cancelar_Contacto").click();
                                //$("#Cambiar").click();
                                $('#Contacto').selectpicker('refresh');
                                $('#Contacto').selectpicker('render');
                                alert(data.msg);
                            }else{
                                alert("Existe un error al guardar: "+data.msg);
                            }
                        }
                    });
                    
                });                
                
                $("#agregardireccion").on('click',function(){
                    var direcion = $("#direcciones").val();
                    var nom =  $("#nom").val();
                    var dir = $("#direc").val();
                    var ciu = $("#ciud").val();
                    var est =$("#est_prov").val();
                    var cod = $("#codpost").val();
                    var pais =$("#PaisNE").val();
                    var TaxIDn =$("#TaxID_nuevo").val();
                    var paisnombre = $('#PaisNE>option:selected').text();
                    var OwnerId = "{!acc.OwnerId}";
                    var datos = {
                        "nombre": nom,
                        "Ciudad":ciu,
                        "codigo_Postal":cod,
                        "Direccion": dir,
                        "Estado_Provincia": est,
                        "Pais": pais,
                        "id":"{!idc}",
                        "OwnerId": OwnerId,
                        "tipo": "nuevo",
                        "TaxID": TaxIDn                        
                    };
                    
                    if(nom == ''){
                        $("#nom").focus();
                        return alert('Ingrese nombre');
                    }
                    
                    if(dir == ''){
                        $("#direc").focus();
                        return alert('Ingrese dirección');
                    }
                    
                    if(ciu == ''){
                        $("#ciud").focus();
                        return alert('Ingrese ciudad');
                    }
                    BtnLoading("#agregardireccion");
                    console.log(datos);
                    $.ajax({
                        dataType: "json",
                        
                        url: "{!$Page.HE_AgregaEditaDir_JSON}",
                        data: { datos: JSON.stringify(datos) },
                        success: function(data) {
                            console.log(data);
                            BtnReset("#agregardireccion");
                            if(data.success){                                
                                contador=data.iddirecion;
                                
                                //se mete en array para buscarlo posteriormente
                                localAddresses.push({
                                    id:contador,
                                    nombre:nom, 
                                    Direccion:dir,  
                                    Ciudad :ciu,
                                    Estado_Provincia:est, 
                                    codigo_Postal:cod, 
                                    Pais:pais 
                                    
                                }); 
                                console.log(' id nueva direccion:' + contador );
                                //document.getElementById("dir_or").options[document.getElementById("dir_or").options.length]=new Option(nom,contador);
                                $('#dir_or').append(new Option(nom + ' - ' + dir, contador));
                                $("#dir_or").val(contador); 
                                $("#nom_dir_or").html(dir); 
                                $("#agregardireccion").hide();
                                $('#Nuevadireccion').modal('hide');
                                $("#selecionardireccion").show();
                                $("#selecion_direcion").show();
                                $("#otra_direcion").hide();
                                $("#Nuevadireccion").hide();
                                
                                $("#nom").val('');
                    			$("#direc").val('');
                        		$("#ciud").val('');
                     			$("#est_prov").val('');
                     			$("#codpost").val('');
                                
                                $('#dir_or').selectpicker('refresh');
                                $('#dir_or').selectpicker('render');
                                $("#selecionardireccion").click();
                                alert(data.msg);
                            }else{
                                alert("Existe un error al guardar: "+data.msg);
                            }
                        }
                    });
                    
                });                
                
                $("#selecionardireccion").on('click',function(){
                    
                    if($('#dir_or').val() == '0'){
                        return alert('Debe seleccionar una dirección válida');
                    }
                    $("#direccionSeleccionada").html('');
                    console.log(localAddresses);       
                    console.log($('#dir_or').val());       
                    //busca nombre de contacto cambiado al seleccionar 
                    for(i=0; i < localAddresses.length; i++){                        
                        if($('#dir_or').val() == localAddresses[i].id){                                                       
                            $("#direccionSeleccionada").html(localAddresses[i].Direccion);
                            console.log('direccion encontrada');   
                        }
                    }
                    
                    $("#Nuevadireccion").modal('hide');
                });
                
                var idnuevo=0;
                $("#agregardestinatario").on('click',function(){
                    BtnLoading("#agregardestinatario");
                    var nom =  $("#nombre_nuevo").val();
                    var ciu = $("#ciuda_nuevo").val();
                    var cod = $("#codigo_nuevo").val();
                    var dir =$("#direcion_nuevo").val();
                    var est = $("#estado_nuevo").val();
                    var pais =$("#Pais_nuevo").val();
                    var paisnombre = $('#Pais_nuevo>option:selected').text();
                    var conn =$("#Contacto_nuevo").val();
                    var Teln = $("#Telefono_nuevo").val();
                    var Emailn =$("#Email_nuevo").val();
                    var TaxIDn =$("#TaxID_nuevo").val();
                    var OwnerId = "{!acc.OwnerId}";
                    
                    if(nom == ''){
                        BtnReset("#agregardestinatario");
                        alert('Ingrese nombre');
                        $("#nombre_nuevo").focus();
                        return;
					} 
                    
                    if(dir == ''){
                        BtnReset("#agregardestinatario");
                        alert('Ingrese dirección');
                        $("#direcion_nuevo").focus();
                        return;
					}
                    
                    if(ciu == ''){
                        BtnReset("#agregardestinatario");
                        alert('Ingrese ciudad');
                        $("#ciuda_nuevo").focus();
                        return;
					}                                         
    
                    if(pais == 'Seleccione un País'){
                        BtnReset("#agregardestinatario");
                        alert('Seleccione País');                        
                        return;
                    }
                    
                    if(conn == ''){
                        BtnReset("#agregardestinatario");
                        alert('Ingrese contacto');
                        $("#Contacto_nuevo").focus();
                        return;
					}
                    
                    if(Teln == ''){
                        BtnReset("#agregardestinatario");
                        alert('Ingrese móvil');
                        $("#Telefono_nuevo").focus();
                        return;
					}
                     
                    console.log(paisnombre);
                    var datos = {
                        "nombre": nom,
                        "Ciudad":ciu,
                        "codigo_Postal":cod,
                        "Direccion": dir,
                        "Estado_Provincia": est,
                        "Pais": pais,
                        "id":"{!idc}",
                        "OwnerId": OwnerId,
                        "Telefono":Teln,
                        "Email": Emailn,
                        "contacto": conn,
                        "TaxID" : TaxIDn
                        
                    };
                    console.log(datos);
                    $.ajax({
                        dataType: "json",
                        url: "{!$Page.HE_AgregarDirecion_JSON}",
                        data: { datos: JSON.stringify(datos) },
                        success: function(data) {
                            console.log(data);
                            BtnReset("#agregardestinatario");
                            if(data.success){
                                idnuevo=data.iddirecion;
                                direccion.push({
                                    id: idnuevo,
                                    nombre: nom, 
                                    Direccion:dir,  
                                    Ciudad :ciu,
                                    Estado_Provincia:est, 
                                    codigo_Postal:cod, 
                                    Pais:paisnombre,
                                    contacto:conn, 
                                    Telefono:Teln, 
                                    Email:Emailn,
                                    TaxID: TaxIDn
                                    
                                });
                                //document.getElementById("direcciones").options[document.getElementById("direcciones").options.length]=new Option(nom ,idnuevo);
                                $('#direcciones').append(new Option(nom, idnuevo));
                                $("#direcciones").val(idnuevo);
                                $("#direcciones").change();
                                
                                $("#NuevoDestinatario").modal('hide');
                                
                                $('#direcciones').selectpicker('refresh');
                                $('#direcciones').selectpicker('render');
                                
                                $("#nombre_nuevo").val('');
                                $("#ciuda_nuevo").val('');
                                $("#codigo_nuevo").val('');
                                $("#direcion_nuevo").val('');
                                $("#Contacto_nuevo").val('');
                                $("#Telefono_nuevo").val('');
                                
                                $("#Pais_nuevo").val('Seleccione un País');
                                $('#Pais_nuevo').selectpicker('refresh');
                                $('#Pais_nuevo').selectpicker('render');
                                
                                alert(data.msg);                                
                            }else{
                                alert("Existe un error al guardar: "+data.msg);
                            }
                        }
                    });
                    
                    
                    
                }); 
                $("#cancelardestinatario").on('click',function(){
                    $("#NuevoDestinatario").modal('hide');
                }); 
                
                ids=0;
                nprod=0;
                $('#addMore').on('click', function(){
                    
                    //var data = $("#tb tr:eq(1)").clone(true).appendTo("#tb");
                    //data.find("input").val('');
                    var td = '';
                    var tr = $('<tr code="'+ids+'" idProducto="'+ids+'">');
                    // $tr = 
                    td = $("<td></td>").html('<input  id="Descripcion'+ids+'" name="Descripcion'+ids+'" type="text" class="form-control"  />');
                    tr.append(td);
                    // td = $("<td></td>").html('<input id="Pais_de_Fabricacion'+ids+'" name="Pais_de_Fabricacion'+ids+'" type="text" class="form-control" size="7" />');
                    td = $("<td></td>").html('<select    class="custom-select" id="Pais_de_Fabricacion'+ids+'" name="Pais_de_Fabricacion'+ids+'"><option value="null">--Ninguno--</option><apex:repeat value="{!listpais}" var="p"><option value="{!p.id}">{!p.name}</option></apex:repeat></select>');
                    tr.append(td);
                    td = $("<td></td>").html('<input   id="Cantidad'+ids+'" pattern="^\d*(\.\d{0,2})?$" name="Cantidad'+ids+'" type="number" class="form-control"  min="1" max="5" />');
