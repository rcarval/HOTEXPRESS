    <style>
        .boton-salesforce {
            background-color: #0070d2;
            color: white;
            border: none;
            padding: 12px 24px 12px 50px; /* espacio a la izquierda para el ícono */
            height: 50px;
            font-size: 30px;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.15);
            background-image: url('https://upload.wikimedia.org/wikipedia/commons/thumb/6/6b/Salesforce.com_logo.svg/1200px-Salesforce.com_logo.svg.png');
            background-repeat: no-repeat;
            background-position: 15px center;
            background-size: 24px 24px;
            transition: background-color 0.3s ease, transform 0.1s ease;
        }

        .boton-salesforce:hover {
            background-color: #005fb2;
            transform: scale(1.02);
        }
    </style>
        
