<apex:page controller="HE_Login" docType="html-5.0" lightningStylesheets="true" showHeader="false" standardStylesheets="false" sidebar="false" applyHtmlTag="false" applyBodyTag="false" >
    
    <html xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" lang="en">
        
       <link rel="stylesheet" href="https://ajax.googleapis.com/ajax/libs/jqueryui/1.11.4/themes/smoothness/jquery-ui.css" />
        <apex:includeScript value="https://ajax.googleapis.com/ajax/libs/jquery/1.7.2/jquery.min.js" />
        <apex:includeScript value="https://ajax.googleapis.com/ajax/libs/jqueryui/1.11.4/jquery-ui.min.js" />
        <link rel="stylesheet" href="{!$Resource.HE + '/css/dashboard.css'}"/>
        <meta charset="utf-8" />
        <meta http-equiv="x-ua-compatible" content="ie=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <apex:slds />
        <title>login</title>
        
        <script>
        $j = jQuery.noConflict();
        $j(document).ready(function($) {
            $("#estado_guia").hide();
            $("#guia").hide();
            $("#consultar").on('click',function(){
                
                var num =  $("#num_guia").val();
                console.log(num);
                
                $.ajax({
                    dataType: "json",
                     
                    url: "{!$Page.HE_ConsultarGuia_JSON}?datos="+num,
                    data: { datos: num },
                    success: function(data) {
                        console.log(data);
                        if(data.success){
                            $("#origen").html(data.Origen+','+data.PaisO);  
                            $("#destino").html(data.Destino+','+data.PaisD);  
                            $("#fecha").html( data.Fecha);  
                            $("#estado").html(data.Estado);  
                            $("#alerta").hide();  
                            $("#estado_guia").show();
                             console.log(data.historial.length);
                            if(data.historial.length>0){
                               
                            var tabla='';
                            tabla= "<table><tr><td >Codigo_Tracking</td>";
                            tabla= "<table><tr><td >Estado</td>";
                            tabla= "<table><tr><td >Fecha</td>";
                            tabla= "<table><tr><td >Detalle</td>";
                            for(var i=0;i<data.historial.length;i++){
                              console.log(data.historial[i]);  
                             tabla+="<tr><td style='width: 100px;text-align: right;'>"+data.historial[i].Codigo_Tracking+"</td>";        
                             tabla+="<td style='width: 100px;text-align: right;'>" +data.historial[i].Estado+"</td>";    
                             tabla+="<td style='width: 100px;text-align: right;'>" +data.historial[i].Fecha+"</td>";    
                             tabla+="<td style='width: 100px;text-align: right;'>" +data.historial[i].Detalle+"</td>";    
                             tabla+="</tr>";
                            }
                             tabla+="</table>";
                                 console.log(tabla); 
                                $("#tabladatos").html(tabla);
                               }
                        }else{
                            $("#texto").html('Guia no encontrada ');  
                            $("#alerta").show();  
                            $("#estado_guia").hide();
                        }
                    }
                });
                
                $("#guia").show();
            });
            
            $("#cerrar").on('click',function(){
                $("#guia").hide();
            });           
        });
        
        </script>
        
        <body class="">
            <apex:form >
                <div class="page">
                    <div class="page-single">
                        <div class="container">
                            <div class="row">
                                <div class="col col-login mx-auto">
                                    <div class="text-center mb-6">
                                        <a href="http://www.hotexpress.cl/" target="_blank"><img src="{!$Resource.HE + '/images/logohotexpress.png'}" height="80" alt=""/></a>
                                    </div>
                                    <form class="card" action="" method="post">
                                        <div class="card-body p-6">
                                            <div class="card-title">Acceso Clientes</div>
                                            <div class="form-group">
                                                <label class="form-label">Email</label>
                                                <!--<input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="Email" value="{!Email}" />-->
                                                <apex:input id="Email" style="aria-describedby:emailHelp"   type="text" styleClass="form-control" value="{!Email}"  />
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">
                                                    Contraseña
                                                    <!-- <a href="#" class="float-right small">¿Olvidaste tu contraseña?</a>-->
                                                </label>
                                                <!--<input  type="password" class="form-control" id="exampleInputPassword1" placeholder="Contraseña" value="{!Contrasena}"/>-->
                                                <apex:inputSecret id="Contrasena" styleClass="form-control" value="{!Contrasena}" />
                                            </div>
                                            <div class="form-footer">
                                                <apex:commandButton value="Ingresar" action="{!validar}"  style="btn btn-primary btn-block" styleClass="btn btn-primary btn-block" />
                                                <apex:outputText value="{!resultMessage}" style="color: red; font-weight: bold;"/>                                                
                                                <!-- <button type="submit" class="btn btn-primary btn-block"  >Entrar</button>-->
                                            </div>
                                        </div>
                                    </form>
                                    <div class="text-center text-muted"> 
                                        ¿No tienes una cuenta en HotExpress? <a href="http://www.hotexpress.cl/new">Nuevo cliente</a><!--http://www2.hotexpress.cl/new-->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </apex:form>
        </body>
    </html>
    
</apex:page>