                                                            <!-- <div class="slds-truncate"   id="{!hi.id}{!rep.idguia}_check"> </div>-->
                                                        </td>
                                                    </tr>
                                                </apex:repeat>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </apex:repeat>
