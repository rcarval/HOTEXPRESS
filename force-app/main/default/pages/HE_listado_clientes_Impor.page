            <script>
            $j = jQuery.noConflict();
            $j(document).ready(function($) {
                     $("#indicar_factura").show();
                    $("#estado_factura").hide();
             
                <apex:repeat value="{!historialdefacturas}" var="hi">
                    <apex:repeat value="{!hi.listarguias}" var="rep">
                        console.log('si entro1');
                $("#{!hi.id}_{!rep.idguia}_check").on('click',function(){
                    if( $(this).is(':checked') ){
                        var cantidad = parseInt($("#{!hi.id}_cantidad").html());
                        $("#{!hi.id}_cantidad").html(cantidad+1);
                        var montoguia = parseInt($("#{!hi.id}_{!rep.idguia}_montoCLP").html().replace('.',''));
                        console.log('montoguia='+montoguia);
                        var monto = parseInt($("#{!hi.id}_monto").html());
                        console.log('monto='+monto);
                        var montototal=monto+montoguia;
                        console.log('montototal='+montototal);
                        $("#{!hi.id}_monto").html(montototal);
                        
                        console.log('chequeado');
                    }else{
                        var cantidad = parseInt($("#{!hi.id}_cantidad").html());
                        $("#{!hi.id}_cantidad").html(cantidad-1);
                        var montoguia = parseInt($("#{!hi.id}_{!rep.idguia}_montoCLP").html().replace('.',''));
                        console.log('montoguia='+montoguia);
                        var monto = parseInt($("#{!hi.id}_monto").html());
                        console.log('monto='+monto);
                        var montototal=monto-montoguia;
                        console.log('montototal='+montototal);
                        $("#{!hi.id}_monto").html(montototal);
                        
                        console.log('no chequeado');
                    }
                    
                });
               
                
                </apex:repeat>       
                </apex:repeat> 
                
                 <apex:repeat value="{!historialdefacturas}" var="hi">
                    <apex:repeat value="{!hi.listarguias}" var="rep">
                 
                $("#{!hi.id}_pre_factura").on('click',function(){
                          var prefactura = [];
                          var codigoconsulta = $(this).attr("value");
                    console.log(codigoconsulta);
                      $("#facturas > tbody > tr").each(function(index, item){
                        var code1 = $(this).attr("code");
                           console.log(code1);
                          if(codigoconsulta==code1){
                       $("#det_factura > tbody > tr").each(function(index, item){
                             var code2 = $(this).attr("code");
                             var idguia = $(this).attr("guia");
                             var check = $("#"+code2+"_check").is(':checked');
                             if(code2.includes(code1)){
                                 console.log('entro aca');
                                 if(check==true){
                                   prefactura.push({
                                         "idguiaconsulta": idguia
                                       });
                                       }
                                 }
                            });
                        }      
                              
                          });
                            
                      if(prefactura.length > 0){
                          var datos=JSON.stringify(prefactura);
                             window.open("HE_PreFactura_Impor?id="+codigoconsulta+"&&data="+datos+"&&VD="+'{!Vdolar}'); 
                      }  
                    
                  console.log(prefactura);   
                });
               
                 </apex:repeat>       
                </apex:repeat> 
                //Expandable function
                <apex:repeat value="{!historialdefacturas}" var="hi">
                    var montof = parseInt($("#{!hi.id}_monto").html());
                $("#{!hi.id}_monto").html(formatNumber(montof));
                
                
                
                
                $("#{!hi.id}_expandableParent").on('click',function(){
                    var eva = $(this).attr('aria-expanded');
                    if(eva == 'true'){
                        $("#{!hi.id}_expandableParent").attr('aria-expanded','false');
                        $("#{!hi.id}_expandableChild").attr('aria-hidden','false');
                        $("#{!hi.id}_expandableDiv").removeClass('slds-is-open');
                        <apex:repeat value="{!hi.listarguias}" var="rep">
                            
                            
                            
                            var montopre = $("#{!hi.id}_{!rep.idguia}_montoCLP").html();
                        $("#{!hi.id}_{!rep.idguia}_montoCLP").html(montopre.replace('.',''));
                        
                            var montopretot = $("#{!hi.id}_{!rep.idguia}_montototal").html();
                        
                        $("#{!hi.id}_{!rep.idguia}_montototal").html(montopretot);
                        </apex:repeat>
                    }else{
                        $("#{!hi.id}_expandableParent").attr('aria-expanded','true');
                        $("#{!hi.id}_expandableChild").attr('aria-hidden','true');
                        $("#{!hi.id}_expandableDiv").addClass('slds-is-open');
                        <apex:repeat value="{!hi.listarguias}" var="rep">
                            var montopre = parseInt($("#{!hi.id}_{!rep.idguia}_montoCLP").html());
                        $("#{!hi.id}_{!rep.idguia}_montoCLP").html(formatNumber(montopre));
                        
                           var montopretot = parseInt($("#{!hi.id}_{!rep.idguia}_montototal").html());
                         $("#{!hi.id}_{!rep.idguia}_montototal").html(formatNumber(montopretot));
                        </apex:repeat>
                    }
                });
                
                
                </apex:repeat>
                
                //Funcion para agregarle separador de miles a los numeros
                function formatNumber(nStr) {
                    nStr += '';
                    x1 = nStr;
                    var rgx = /(\d+)(\d{3})/;
                    while (rgx.test(x1)) {
                        x1 = x1.replace(rgx, '$1' + '.' + '$2');
                    }
                    return x1;
                }
                
                
                
                
                
                
                $("#factura_cliente").on('click',function(){
                    console.log("entro");
                    myFunction();
                });
                function myFunction() {
                    var prodsfacturables = []; 
                    $("#facturas > tbody > tr").each(function(index, item){
                        
                        var code1 = $(this).attr("code");
                        var nombre = $("#"+code1+"_name").html();
                        var rut = $("#"+code1+"_RUT").html();
                        var monto = $("#"+code1+"_monto").html();
                        var comuna = $("#"+code1+"_comuna").html();
                        var direccion = $("#"+code1+"_direccion").html();
                        var oc = $("#"+code1+"_oc").val();
                        var comentario = $("#"+code1+"_comentario").val();
                        console.log(code1);
                        console.log(nombre);
                        console.log(rut);
                        console.log(monto);
                         console.log(oc);
                        console.log(comentario);
                        var guias = []; 
                        $("#det_factura > tbody > tr").each(function(index, item){
                            var code2 = $(this).attr("code");
                             var idguia = $(this).attr("guia");
                            if(code2.includes(code1)){
                                var numeroguia = $("#"+code2+"_nguia").html();
                                var check = $("#"+code2+"_check").is(':checked');
                                var monto1 = $("#"+code2+"_montoUSD").html();
                                var monto2 = $("#"+code2+"_montoCLP").html().replace('.','');
                                var destino = $("#"+code2+"_destino").html();
                                var tipo = $("#"+code2+"_tipo").html();
                                var fecha = $("#"+code2+"_fecha").html();
                                console.log("id codigo guia ");  
                                console.log( code2);
                                console.log( idguia);
                                console.log(numeroguia);
                                console.log(check);
                                console.log(monto);
                               if(check==true){ 
                                guias.push({
                                    "idguia": idguia,
                                    "idproducto": numeroguia,
                                    "pais_destino": destino,
                                    "tipo": tipo,
                                    "fecha": fecha,
                                    "montoUSD": monto1,
                                    "montoCLP": monto2
                                });
                              }  
                            }
                        });
                        if(parseInt(monto)>0){
                        prodsfacturables.push({  
                            "id":code1,
                            "name":nombre,
                            "RUT":rut,
                            "comuna":comuna,
                            "direccion":direccion,
                            "contadorpendientes":1,
                            "oc": oc,
                            "comentario": comentario,
                            "listarguias":guias
                        });
                            }
                        
                        
                    });
                    // console.log(prodsfacturables);
                    
                    
                     $.ajax({
                        dataType: "json",
                        url: "HE_enviar_facturacion_impor",
                        data: { datos: JSON.stringify(prodsfacturables) },
                        success: function(data) {
                              $("#estado_factura").show();
                             $("#indicar_factura").hide();
                    
                            console.log("respuesta de factura"); 
                            console.log(data.length);
                            for(var i=0;i<data.length;i++){
                             $tabla = $("#resultado_facturas").find('tbody:last');
                        $tr = $('<tr code="'+data[i].id+'" idfactura="'+data[i].numerofactura+'">');
                        
                        $col = $('<td>').attr('align','center').html('<input type="hidden" value="'+data[i].name+'" id="nombrecliente_'+data[i].id+'" />'+data[i].name);
                        $tr.append($col);
                        $col = $('<td>').attr('align','center').html('<input type="hidden" value="'+data[i].RUT+'" id="codigo_'+data[i].id+'" />'+data[i].RUT);
                        $tr.append($col);
                        $col = $('<td>').attr('align','center').html('<input type="hidden" value="'+data[i].estadofactura+'" id="codigo_'+data[i].id+'" />'+data[i].estadofactura);
                        $tr.append($col);
                        $col = $('<td>').attr('align','center').html('<input type="hidden" value="'+data[i].numerofactura+'" id="codigo_'+data[i].id+'" />'+data[i].numerofactura);
                        $tr.append($col);
                        $col = $('<td width="50px">').attr('align','center').html('<input width="50px" type="hidden" value="'+data[i].descripcionfactura+'" id="codigo_'+data[i].id+'" />'+data[i].descripcionfactura);
                        $tr.append($col);
                         $col = $('<td>').attr('align','center').html('<button  class="delafactura"  value="'+data[i].numerofactura+'" codigo="'+data[i].numerofactura+'" id="ver documento_'+data[i].numerofactura+'" >ver Factura</button>');
                        $tr.append($col);
                       $tabla.append($tr);
                            }
                   
                            /*      if(data.success){
                            
                                  window.location.assign("HE_visualizar_PDF_Factura");
                            }else{
                                alert("Existe un error al guardar: "+data.msg);
                            }*/
                        }
                    });
                    
                    // window.location.assign("HE_visualizar_PDF_Factura");
                    
                }
                
          $(document).on('click', "#resultado_facturas button.delafactura", function() {
                    var code = $(this).attr('codigo');
                    console.log(code);
               window.open("HE_visualizar_PDF_Factura?id="+code);
              // window.location.assign("HE_visualizar_PDF_Factura?id="+code);
                });         
               
              $("#volver").on('click',function(){
                  //  window.location.assign("HE_listado_clientes");
                    window.location.assign("HE_Consultar_Cliente_Facturar_Impor");
                });
              $("#volver_2").on('click',function(){
                  // window.location.assign("HE_listado_clientes")
                    window.location.assign("HE_Consultar_Cliente_Facturar_Impor"); 
                });
                 $("#salir").on('click',function(){
                     window.location.assign("/");  
                });
            });
            
            </script>
