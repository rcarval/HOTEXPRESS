            <script>
            $j = jQuery.noConflict();
            $j(document).ready(function($) {
                
                $("#fechaInicio").datepicker({ dateFormat: 'dd-mm-yy' });
                $("#fechaFin").datepicker({ dateFormat: 'dd-mm-yy' });
            });
             
            
            function check(event){
        var ejecutar=true;
         var dolar=  document.getElementById("Dolar").value;
         var fecheIN=  document.getElementById("fechaInicio").value;
         var fecheFin=  document.getElementById("fechaFin").value;
        
                console.log(dolar);      
                console.log(fecheIN);      
                console.log(fecheFin);       
           if(dolar==null || dolar==0  || dolar==''){
               alert('falta valor dolar');
                 ejecutar=false;
               }
               if(fecheIN==''){
                    alert('ingrese fecha inicio de facturacion');
                 ejecutar=false;
               }
                 if(fecheFin==''){
                     alert('ingrese fecha Fin de facturacion');
                 ejecutar=false;
               }
        if(ejecutar==true){
        HE_Facturar_Controller.facturar( dolar,fecheIN,fecheFin,
                                           function(result, event) {
                                               alert(result);
                                            
                                           },
                                           {buffer: true, escape: true, timeout: 120000}
                                          );
        
        }
    }
            
            </script>
