                        <label class="slds-form-element__label" for="cantidad">Valor Dolar</label>
                        <div class="slds-form-element__control">
                            <input type="Number" id="Dolar" class="slds-input" value="0" size="5"/>
                        </div>
                    </div>
                </div>                
