            <script>
            // requirejs.config({
            //    baseUrl: '.'
            //});
            </script>
            <script>
            $j = jQuery.noConflict();
            $j(document).ready(function($) {
                $("#Nuevadireccion").hide();
                $("#guia").hide();
                $("#alerta").hide();
                $("#estado_guia").hide();
                $("#loading").hide();

                
                $("#cuentacliente").val('{!idc}');
                var datos = [];
                datos=JSON.parse('{!JSONrespuentacuentas}');
                
                console.log(datos );
                console.log(datos);
                
                $("#consultar").on('click',function(){
                    
                    var num =  $("#num_guia").val();
                    console.log(num);
                    if(num==null || num=='' ){
                        alert("ingrese numero de GUIA " );
                        return;
                        }
                        
                    
                    $.ajax({
                        dataType: "json",
                        
                        url: "{!$Page.HE_ConsultarGuia_JSON}?datos="+num,
                        data: { datos: num },
                        success: function(data) {
                            console.log(data);
                            if(data.success){
                                $("#origen").html(data.Origen+','+data.PaisO);  
                                $("#destino").html(data.Destino+','+data.PaisD);  
                                $("#fecha").html( data.Fecha);  
                                $("#estado").html(data.Estado); 
                                 $("#ver_Factura").val(data.Id_guia); 
                                
                                $("#alerta").hide();  
                                $("#estado_guia").show();
                                if(data.historial.length>0){
                               
                            var tabla='';
                            tabla+= "<table class='table table-striped table-bordered table-hover' >";
                            tabla+= "<tr><th >Codigo_Tracking</th>";
                            tabla+= "<th >Estado</th>";
                            tabla+= "<th >Fecha</th>";
                            tabla+= "<th>Detalle</th></tr>";
                            for(var i=0;i<data.historial.length;i++){
                              console.log(data.historial[i]);  
                             tabla+="<tr style='border: 1px'><td >"+data.historial[i].Codigo_Tracking+"</td>";        
                             tabla+="<td>" +data.historial[i].Estado+"</td>";    
                             tabla+="<td >" +data.historial[i].Fecha+"</td>";    
                             tabla+="<td >" +data.historial[i].Detalle+"</td>";    
                             tabla+="</tr>";
                            }
                             tabla+="</table>";
                                 console.log(tabla); 
                                $("#tabladatos").html(tabla);
                               }
                            }else{
                                $("#texto").html('Guia no encontrada ');  
                                $("#alerta").show();  
                                $("#estado_guia").hide();
                            }
                        }
                    });
                    
                    $("#guia").show();
                });
                $("#cerrar,#cerrar2").on('click',function(){
                    $("#guia").hide();
                });
                $('#cuentacliente').on('change', function(){
                     $("#loading").show();
                    var valor=$("#cuentacliente").val(); 
                    for(i=0;i<datos.length;i++) {
                        if(datos[i].IDcuenta==valor){
                            $("#loading").hide();
                            window.location.replace("{!$Page.HE_Inicio}?idc="+datos[i].IDcuenta+"&&idp="+datos[i].IDcontacto+"");     
                        }
                        
                    }  
                     
                }); 
                
                
                
            });
            
            
            function nuevo_envio() {
                console.log('nuevo_envio');
                 $("#loading").show();
                window.location.replace("{!$Page.HE_Nuevo_Envio}?idc={!idc}&&idp={!idp}");   
            }
            function nueva_solicitud() {
                console.log('nueva_solicitud');
                 $("#loading").show();
                window.location.replace("{!$Page.HE_solicitud_de_Retiro}?idc={!idc}&&idp={!idp}");   
            }
            function mis_documentos() {
                console.log('mis_documentos');
                 $("#loading").show();
                window.location.replace("{!$Page.HE_Mis_Documentos}?idc={!idc}&&idp={!idp}");   
            }
              function inicio() {
                console.log('inicio');
                 $("#loading").show();
                window.location.replace("{!$Page.HE_Inicio}?idc={!idc}&&idp={!idp}");   
            }
            function ver_factura(dato){
                    console.log('ver_factura');
                   console.log(dato);
                     window.open("{!$Page.HE_factura_expo}?id="+dato,"ventana1","width=1000,height=500,scrollbars=NO"); 
                    
                    }
            </script> 
            
